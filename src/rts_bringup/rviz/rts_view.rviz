Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 10
      
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        odom:
          base_link:
            lidar_front: {}
            camera_left_optical: {}
            camera_right_optical: {}
            imu_link: {}
      
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /lidar/scan
      Size (m): 0.05
      Size (Pixels): 3
      Color Transformer: Intensity
      
    - Class: rviz_default_plugins/Image
      Name: Camera Left
      Enabled: true
      Topic:
        Value: /stereo/left/image_raw
      
    - Class: rviz_default_plugins/Image
      Name: Camera Right
      Enabled: true
      Topic:
        Value: /stereo/right/image_raw

  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
    
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 0